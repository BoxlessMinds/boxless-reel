# =============================================================================
# YouTube Transcript API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite database connection string
DATABASE_URL=sqlite:///./transcripts.db

# -----------------------------------------------------------------------------
# Registration Configuration
# -----------------------------------------------------------------------------
# Require invitation code for registration (true/false)
# Can be overridden by admin via the UI
REQUIRE_INVITATION_CODE=false

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# Agent Configuration (Optional - Required for LLM-powered querying)
# =============================================================================
# At least one LLM provider API key is required to enable agent features

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# -----------------------------------------------------------------------------
# OpenAI API key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API key (get from: https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
# Default LLM provider: "anthropic" or "openai"
DEFAULT_LLM_PROVIDER=anthropic

# Default model ID for the chosen provider
# Anthropic: claude-sonnet-4-5, claude-opus-4-1, claude-3-5-haiku-20241022
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
DEFAULT_MODEL=claude-sonnet-4-5

# OpenAI embedding model for vector search
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Vector Database Configuration
# -----------------------------------------------------------------------------
# Path to LanceDB storage directory (will be created if doesn't exist)
LANCEDB_URI=./data/lancedb

# -----------------------------------------------------------------------------
# Agent Behavior Configuration
# -----------------------------------------------------------------------------
# Maximum transcript chunks to include in agent context (1-50)
MAX_CONTEXT_CHUNKS=10

# Target size for transcript text chunks in characters (100-5000)
CHUNK_SIZE=1000

# Overlap between consecutive chunks in characters (0-500, must be < CHUNK_SIZE)
CHUNK_OVERLAP=200

JWT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Web Search Configuration (Optional - for enhanced agent responses)
# -----------------------------------------------------------------------------
# Tavily API key for web search (get from: https://tavily.com/)
TAVILY_API_KEY=

# Enable/disable web search for agent queries (true/false)
WEB_SEARCH_ENABLED=true

# Maximum web search results to return (1-10)
WEB_SEARCH_MAX_RESULTS=5

# -----------------------------------------------------------------------------
# Whisper Fallback Configuration (for videos without captions)
# -----------------------------------------------------------------------------
# Enable/disable Whisper API fallback when captions are unavailable (true/false)
WHISPER_FALLBACK_ENABLED=true

# Whisper model to use for transcription
WHISPER_MODEL=whisper-1

# Maximum video duration in seconds to attempt Whisper fallback (default 3600 = 1 hour)
WHISPER_MAX_DURATION_SECONDS=3600

# Audio bitrate for mp3 compression (lower = smaller file, 48k keeps 1hr under 25MB)
WHISPER_AUDIO_BITRATE=48k

# -----------------------------------------------------------------------------
# Document Upload Configuration
# -----------------------------------------------------------------------------
# Path to document storage directory
DOCUMENTS_STORAGE_PATH=./data/documents

# Maximum documents per session (1-20)
MAX_DOCUMENTS_PER_SESSION=5

# Target size for document text chunks in characters (100-5000)
DOCUMENT_CHUNK_SIZE=1000

# Overlap between consecutive document chunks in characters (0-500)
DOCUMENT_CHUNK_OVERLAP=200