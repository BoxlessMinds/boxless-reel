# =============================================================================
# Boxless Reel - Environment Configuration
# =============================================================================
# Copy this file to .env.docker (Docker) or .env (manual setup) and fill in
# your values. Every setting the app reads is listed here.
#
# Only JWT_SECRET_KEY is required. Everything under "Optional" already has a
# working value, or is empty when the feature is off until you add a key.
#
# The URL values below are set for the Docker quick start, where the web
# interface runs on http://localhost:8050. For manual setup (web interface on
# :8080, API on :8001), change the lines marked "Manual setup".

# #############################################################################
# REQUIRED
# #############################################################################

# -----------------------------------------------------------------------------
# Authentication (Required)
# -----------------------------------------------------------------------------
# Secret used to sign login tokens. The API will not start until you set this
# to a random value of at least 32 characters. Generate one with either command:
#   openssl rand -hex 32
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# #############################################################################
# OPTIONAL
# #############################################################################

# -----------------------------------------------------------------------------
# Authentication and invitations
# -----------------------------------------------------------------------------
# Algorithm used to sign login tokens
JWT_ALGORITHM=HS256

# Minutes before a login token expires and is silently refreshed (1-1440)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Days before you have to sign in again (1-30)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Require an invitation code to register (true/false). The app's own default is
# true; this file sets false so you can create your first account. An admin can
# change it later in the app.
REQUIRE_INVITATION_CODE=false

# Days before an unused invitation expires (1-30)
INVITATION_EXPIRE_DAYS=7

# Maximum unused invitations each user can have at once (1-50)
MAX_PENDING_INVITATIONS_PER_USER=5

# Key that encrypts the API keys users save on the app's Settings page. If left
# empty, a new key is made at every start and saved keys stop working after a
# restart. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# CORS and URLs
# -----------------------------------------------------------------------------
# The web interface's address, used in invitation links and after connecting a
# YouTube account.
# Manual setup: http://localhost:8080
FRONTEND_URL=http://localhost:8050

# Web addresses allowed to call the API from a browser. The bundled web
# interface doesn't need this; it matters only if you serve the interface from
# a different address than the API. Must be a JSON list, as shown.
ALLOWED_ORIGINS=["http://localhost:8050","http://localhost:8080"]

# -----------------------------------------------------------------------------
# AI providers and models
# -----------------------------------------------------------------------------
# AI chat needs at least one of these two keys.
# OpenAI API key (get from: https://platform.openai.com/api-keys). Also used to
# index transcripts for search and for the Whisper fallback, so set it even if
# you chat with Claude.
OPENAI_API_KEY=

# Anthropic API key (get from: https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Default AI provider: anthropic or openai
DEFAULT_LLM_PROVIDER=anthropic

# Default model ID for the chosen provider
DEFAULT_MODEL=claude-sonnet-4-5

# OpenAI model used to index text for search
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Vector search and chunking
# -----------------------------------------------------------------------------
# Folder for the search index (created if it doesn't exist)
LANCEDB_URI=./data/lancedb

# Maximum transcript pieces given to the AI per question (1-50)
MAX_CONTEXT_CHUNKS=10

# Size of each transcript piece, in characters (100-5000)
CHUNK_SIZE=1000

# Characters shared between neighbouring transcript pieces (0-500, and less
# than CHUNK_SIZE)
CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Web search
# -----------------------------------------------------------------------------
# Tavily API key, to let chat search the web (get from: https://tavily.com/)
TAVILY_API_KEY=

# Let chat search the web when a Tavily key is set (true/false)
WEB_SEARCH_ENABLED=true

# Maximum web search results per question (1-10)
WEB_SEARCH_MAX_RESULTS=5

# -----------------------------------------------------------------------------
# Whisper (transcribes videos that have no captions; needs OPENAI_API_KEY)
# -----------------------------------------------------------------------------
# Use Whisper when a video has no captions (true/false)
WHISPER_FALLBACK_ENABLED=true

# OpenAI Whisper model
WHISPER_MODEL=whisper-1

# Longest video, in seconds, to send to Whisper (60-14400; 3600 = 1 hour)
WHISPER_MAX_DURATION_SECONDS=3600

# Audio bitrate for the upload (lower = smaller file; 48k keeps 1 hour under 25MB)
WHISPER_AUDIO_BITRATE=48k

# -----------------------------------------------------------------------------
# Documents
# -----------------------------------------------------------------------------
# Folder for uploaded documents
DOCUMENTS_STORAGE_PATH=./data/documents

# Maximum documents per chat session (1-20)
MAX_DOCUMENTS_PER_SESSION=5

# Size of each document piece, in characters (100-5000)
DOCUMENT_CHUNK_SIZE=1000

# Characters shared between neighbouring document pieces (0-500)
DOCUMENT_CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Google / YouTube (playlist features; off until both OAuth values are set)
# -----------------------------------------------------------------------------
# OAuth client ID and secret from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where Google sends users back after they connect. Must exactly match a
# redirect URI registered in Google Cloud Console.
# Manual setup: http://localhost:8001/api/youtube-auth/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8050/api/youtube-auth/callback

# Daily YouTube Data API units your Google project allows (at least 1)
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# Units a playlist change may spend when no budget is given (at least 1)
YOUTUBE_DEFAULT_APPLY_BUDGET=200

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Database connection string. Docker ignores this value and always uses
# data/transcripts.db (see docker-compose.yml).
DATABASE_URL=sqlite:///./transcripts.db

# Folder for uploaded YouTube watch-history files (from Google Takeout)
WATCH_HISTORY_STORAGE_PATH=./data/watch-history

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
